<odoo>
    <data>
        <!-- Extension to Account Move (Invoice) Form View -->
        <record id="view_move_form_inherit_stock_indicator" model="ir.ui.view">
            <field name="name">account.move.form.inherit.stock.indicator</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Add Blocking Banner at the top of the invoice lines page -->
                <xpath expr="//field[@name='invoice_line_ids']" position="before">
                    <field name="stock_warning_banner" nolabel="1" colspan="2"/>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']" position="attributes">
                    <attribute name="widget">stock_restricted_section_and_note_one2many</attribute>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="after">
                    <field name="virtual_available_at_date" column_invisible="True"/>
                    <field name="qty_available_today" optional="show"/>
                    <field name="free_qty_today" column_invisible="True"/>
                    <field name="scheduled_date" column_invisible="True"/>
                    <field name="forecast_expected_date" column_invisible="True"/>
                    <field name="warehouse_id" column_invisible="True"/>
                    <field name="move_type" column_invisible="True"/>
                    <field name="state" column_invisible="True"/>
                    <field name="is_mto" column_invisible="True"/>
                    <field name="move_ids" column_invisible="True"/>
                    <widget name="stock_availability_icon" width="20px"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
