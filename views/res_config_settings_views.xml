<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_stock_restriction" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.stock.restriction</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <!-- Sales Settings: Insert after 'Product Catalog' block -->
                <xpath expr="//block[@name='catalog_setting_container']" position="after">
                    <block title="Stock Restrictions" id="stock_restriction_sale_setting">
                        <setting id="restrict_zero_stock_sale" help="Impide agregar productos con stock cero o negativo a las órdenes de venta.">
                            <field name="restrict_zero_sale"/>
                        </setting>
                    </block>
                </xpath>

                <!-- Invoicing Settings: Insert after 'Customer Invoices' block -->
                 <xpath expr="//block[@id='invoicing_settings']" position="after">
                    <block title="Stock Restrictions" id="stock_restriction_account_setting">
                        <setting id="restrict_zero_stock_invoice" help="Impide agregar productos con stock cero o negativo a las facturas de cliente.">
                            <field name="restrict_zero_invoice"/>
                        </setting>
                    </block>
                </xpath>
                
                <!-- POS Settings: Insert after 'PoS Interface' block -->
                 <xpath expr="//block[@id='pos_interface_section']" position="after">
                    <block title="Stock Restrictions" id="stock_restriction_pos_setting">
                        <setting id="restrict_zero_stock_pos" help="Impide agregar productos con stock cero o negativo en el POS.">
                            <field name="restrict_zero_pos"/>
                        </setting>
                    </block>
                </xpath>    
                 <!-- POS Settings (if POS installed block exists, trying to find a good spot) -->
                 <!-- Usually POS has its own block 'pos_interface' or similar, strict inheritance might fail if block id not found. -->
                 <!-- Safer to put in a general section or try 'point_of_sale' block if knowable. -->
                 <!-- For now, since user has POS, we'll try to check if we can add it safely. -->
                 <!-- Adding to general settings for visibility if specific blocks are hard to target without exact IDs. -->
            </field>
        </record>
    </data>
</odoo>
